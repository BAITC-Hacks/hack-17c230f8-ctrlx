# Без ключа проект работает в DEMO-режиме (rule-based). Настоящие значения — только в .env.local (в git не попадает).
# DEMO_MODE: auto — LLM, если заданы ключ и модель; 1 — всегда rule-based.
DEMO_MODE=auto
LLM_API_KEY=
# OpenAI: https://api.openai.com/v1 · NVIDIA: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Supabase команды — по желанию: без него проект работает на локальных данных. Значения подтягивает scripts/setup.sh,
# проверка — scripts/db-check.sh. SERVICE_ROLE — только на сервере, никогда в клиентский код и не с префиксом NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
